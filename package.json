{
  "name": "lumnus-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "lumnus-frontend",
    "lumnus-backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w lumnus-frontend",
    "dev:backend": "npm run dev -w lumnus-backend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cloudinary": "^2.10.0"
  }
}
